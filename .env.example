# eBay-Entwicklerkonto (developer.ebay.com → Application Keys → Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Warenbestand und Mailinglisten kommen vom Ghostwriter auf demselben Server
WARENBESTAND_CSV=/opt/ghostwriter/data/warenbestand.csv
MAILINGLISTEN=/opt/ghostwriter/data/mailinglisten
# Versand der fertigen Liste an Marc über das IONOS-Postfach des Ghostwriters
GHOSTWRITER_ENV=/opt/ghostwriter/.env
